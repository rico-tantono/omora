# Supabase (Settings > API in your project dashboard). Use the publishable key, never the secret key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# CARTO basemap key
VITE_CARTO_API_KEY=your_carto_api_key_here

# Optional: contact email sent with location searches (recommended by the Nominatim usage policy)
VITE_NOMINATIM_EMAIL=
